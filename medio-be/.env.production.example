# ═══════════════════════════════════════════════════════════════════════════
# .env.production.example — TEMPLATE untuk deployment production
# ═══════════════════════════════════════════════════════════════════════════
# Copy ke .env.production dan isi nilai yang sesuai.
# JANGAN commit file .env.production ke repo.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Optik Medio"
APP_ENV=production
APP_KEY=                                      # generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.optikmedio.com           # backend domain
FRONTEND_URL=https://optikmedio.com           # frontend domain (untuk CORS, sitemap, CSP)

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=optikmedio_prod
DB_USERNAME=
DB_PASSWORD=

# ── Session & Sanctum (P1-5 Phase 2) ─────────────────────────────────────────
# CRITICAL: konfigurasi salah → user logout terus / cookie bocor.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading dot (.) agar cookie shared antar subdomain (api.optikmedio.com → optikmedio.com)
SESSION_DOMAIN=.optikmedio.com
SESSION_SECURE_COOKIE=true                   # HARUS true di production HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax                        # 'strict' jika tidak ada cross-subdomain navigation

# Sanctum stateful — list domain frontend TANPA scheme/port.
# Saat user dari https://optikmedio.com hit https://api.optikmedio.com,
# Sanctum baca cookie session via stateful domain check.
SANCTUM_STATEFUL_DOMAINS=optikmedio.com,www.optikmedio.com

# ── Queue & Cache ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis                       # production: pakai redis untuk performance

CACHE_STORE=redis
CACHE_PREFIX=optikmedio_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Mail (production: pakai service real) ────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=                                   # mis. smtp.resend.com / mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@optikmedio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Xendit (P1-1 & P1-2 Phase 2) ─────────────────────────────────────────────
XENDIT_SECRET_KEY=                           # dari Xendit dashboard
XENDIT_WEBHOOK_TOKEN=                        # webhook verification token
# IP whitelist Xendit production. WAJIB diisi.
# Cek IP terkini di: https://docs.xendit.co/xenplatform/webhooks
XENDIT_WEBHOOK_ALLOWED_IPS=

# ── RajaOngkir ───────────────────────────────────────────────────────────────
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_DISTRICT_ID=1391

# ── AWS (jika pakai S3 untuk storage) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
