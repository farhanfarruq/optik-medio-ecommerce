# ═══════════════════════════════════════════════════════════════════════════
# .env.example — TEMPLATE untuk Optik Medio frontend (Vue 3 / Vite)
# ═══════════════════════════════════════════════════════════════════════════
# Copy ke .env (dev) atau .env.production (prod build).
# Vite hanya expose variable yang ber-prefix VITE_ ke browser.
# ═══════════════════════════════════════════════════════════════════════════

# ── Backend API URL ──────────────────────────────────────────────────────────
# Dev: http://localhost:8000/api
# Prod: https://api.optikmedio.com/api
VITE_API_URL=http://localhost:8000/api
